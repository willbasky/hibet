cabal-version:   3.0
name:            hewts
version:         0.0.0.0
synopsis:        See README for more info
description:
  See README for more info.
  See README.md for more details.

license:         BSD-3-Clause
license-file:    LICENSE
author:          Vladislav
maintainer:      Vladislav <email@email.com>
copyright:       2026 Vladislav
build-type:      Simple
extra-doc-files:
  CHANGELOG.md
  README.md

tested-with:     GHC ==9.10.3

common exec-options
  ghc-options:
    -with-rtsopts=-N1 -with-rtsopts=-qn8 -with-rtsopts=-A64m
    -with-rtsopts=-AL256m -with-rtsopts=-I0 -with-rtsopts=-T

common common-options
  build-depends:      base >=4.11 && <5
  default-language:   Haskell2010
  default-extensions:
    ConstraintKinds
    DeriveGeneric
    DerivingStrategies
    GeneralizedNewtypeDeriving
    InstanceSigs
    KindSignatures
    LambdaCase
    OverloadedStrings
    PatternSynonyms
    RecordWildCards
    ScopedTypeVariables
    StandaloneDeriving
    TupleSections
    TypeApplications
    ViewPatterns

library
  import:          common-options
  hs-source-dirs:  src
  exposed-modules:
    Convert
    Convert.Grammar.Rule.Constraint01
    Convert.Grammar.Rule.Constraint08
    Convert.Grammar.Rule.Constraint09
    Convert.Grammar.Rule.Constraint10
    Convert.Grammar.Rule.Constraint11
    Convert.Grammar.Rule.Constraint12
    Convert.Grammar.Rule.Constraint13
    Convert.Grammar.Rule.Constraint14
    Convert.Grammar.Rule.Constraint15
    Convert.Grammar.Rule.Constraint16
    Convert.Grammar.Rule.Constraint17
    Convert.Grammar.Rule.Constraint18
    Convert.Grammar.Rule.Constraint19
    Convert.Grammar.Rule.Constraint20
    Convert.Grammar.Rules.Grammar01
    Convert.Grammar.Rules.Grammar08
    Convert.Grammar.Rules.Grammar09
    Convert.Grammar.Rules.Grammar10
    Convert.Grammar.Rules.Grammar11
    Convert.Grammar.Rules.Grammar12
    Convert.Grammar.Rules.Grammar13
    Convert.Grammar.Rules.Grammar14
    Convert.Grammar.Rules.Grammar15
    Convert.Grammar.Rules.Grammar16
    Convert.Grammar.Rules.Grammar17
    Convert.Grammar.Rules.Grammar18
    Convert.Grammar.Rules.Grammar19
    Convert.Grammar.Rules.Grammar20
    Convert.Grammar.Structures
    -- Convert.Grammar.Rule
    Convert.Token
    Convert.Grammar
    Convert.Grammar.Common
    Convert.Tokenizer.Wylie
    Convert.Tokenizer.Unicode    
    Syllables
    Convert.Grammar.Parser

  build-depends:
    , bytestring
    , extra
    , massiv
    , megaparsec
    , pretty-simple
    , text
    , unordered-containers
    , bytestring-trie

executable hewts
  import:         common-options
  hs-source-dirs: app
  main-is:        Main.hs
  build-depends:  hewts
  ghc-options:    -threaded -rtsopts -with-rtsopts=-N

test-suite hewts-test
  import:         common-options
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Spec.hs
  other-modules:
    Test.Grammar.Rule.Constraint01
    Test.Grammar.Rule.Constraint08
    Test.Grammar.Rule.Constraint09
    Test.Grammar.Rule.Constraint10
    Test.Grammar.Rule.Constraint11
    Test.Grammar.Rule.Constraint12
    Test.Grammar.Rule.Constraint13
    Test.Grammar.Rule.Constraint14
    Test.Grammar.Rule.Constraint15
    Test.Grammar.Rule.Constraint16
    Test.Grammar.Rule.Constraint17
    Test.Grammar.Rule.Constraint18
    Test.Grammar.Rule.Constraint19
    Test.Grammar.Rule.Constraint20
    -- Test.Grammar.Rule.Structures
    Test.Tokenizer.Types
    Test.Tokenizer.Spans
    Test.Tokenizer.Tricky
    Test.Tokenizer.Integration
    Test.Tokenizer.Golden

  build-depends:
    hewts,
    bytestring,
    text,
    unordered-containers,
    tasty,
    tasty-hunit,
    tasty-golden
  ghc-options:    -threaded -rtsopts -with-rtsopts=-N

benchmark hewts-benchmark
  import:         common-options
  type:           exitcode-stdio-1.0
  hs-source-dirs: benchmark
  main-is:        Main.hs

  -- build-depends:  hewts
  ghc-options:    -threaded -rtsopts -with-rtsopts=-N
