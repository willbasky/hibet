cabal-version: 3.0
name: hibet
version: 2.0.0
license: BSD-3-Clause
license-file: LICENSE
copyright: 2023 willbasky
maintainer: willgame(at)mail(dot)ru
author: willbasky
tested-with: ghc ==9.8.4 || ==9.10.3
homepage: https://github.com/willbasky/Hibet
bug-reports: https://github.com/willbasky/Hibet/issues
synopsis: translator
description: tibetan-english translator
category: Utility
build-type: Simple
extra-source-files:
  test/env/data/dicts/*.txt
  test/env/data/key-aliases.tsv
  test/env/data/titles.toml

extra-doc-files:
  CHANGELOG.md
  README.md

source-repository head
  type: git
  location: https://github.com/willbasky/Hibet.git

library
  exposed-modules:
    Dictionary
    Env
    Label
    Translator
    Type
    Utility

  hs-source-dirs: src
  default-language: Haskell2010
  default-extensions:
    DataKinds
    DeriveGeneric
    DerivingStrategies
    DuplicateRecordFields
    FlexibleContexts
    FlexibleInstances
    GADTs
    LambdaCase
    MultiParamTypeClasses
    OverloadedRecordDot
    OverloadedStrings
    PolyKinds
    RankNTypes
    RecordWildCards
    ScopedTypeVariables
    TemplateHaskell
    TupleSections
    TypeApplications
    TypeFamilies
    TypeOperators
    TypeSynonymInstances
    UndecidableInstances

  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-uni-patterns
    -Wincomplete-record-updates
    -Wredundant-constraints
    -fhide-source-paths
    -Wpartial-fields
    -Wmissing-deriving-strategies
    -fwrite-ide-info
    -hiedir=.hie
    -Wunused-packages

  build-depends:
    base >=4.11 && <5,
    bytestring >=0.11.5.4 && <0.13,
    containers >=0.6.7 && <0.8,
    deepseq >=1.4.8 && <1.6,
    directory >=1.3.7 && <1.4,
    extra >=1.8 && <1.9,
    filepath >=1.4.2 && <1.6,
    hewts >=0.1 && <0.2,
    ki >=1.0 && <1.1,
    parallel >=3.2.2 && <3.3,
    stm >=2.5 && <2.6,
    text >=2.0.2 && <2.2,
    text-rope >=0.3 && <0.4,
    tomland >=1.3.3.2 && <1.4,
    unordered-containers >=0.2.20 && <0.3,

test-suite hibet-labels
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test/labels
  default-language: Haskell2010
  default-extensions:
    DataKinds
    DeriveGeneric
    DerivingStrategies
    DuplicateRecordFields
    FlexibleContexts
    FlexibleInstances
    GADTs
    LambdaCase
    MultiParamTypeClasses
    OverloadedStrings
    PolyKinds
    RankNTypes
    RecordWildCards
    ScopedTypeVariables
    TemplateHaskell
    TupleSections
    TypeApplications
    TypeFamilies
    TypeOperators
    TypeSynonymInstances
    UndecidableInstances

  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-uni-patterns
    -Wincomplete-record-updates
    -Wredundant-constraints
    -fhide-source-paths
    -Wpartial-fields
    -Wmissing-deriving-strategies
    -fwrite-ide-info
    -hiedir=.hie
    -Wunused-packages
    -Wall
    -threaded
    -rtsopts
    -with-rtsopts=-N

  build-depends:
    base >=4.11 && <5,
    bytestring >=0.11.5.3 && <0.13,
    containers >=0.6.7 && <0.8,
    hibet,
    hspec >=2.11.12,

test-suite hibet-env
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test/env
  other-modules:
    Paths

  default-language: Haskell2010
  default-extensions:
    DataKinds
    DeriveGeneric
    DerivingStrategies
    DuplicateRecordFields
    FlexibleContexts
    FlexibleInstances
    GADTs
    LambdaCase
    MultiParamTypeClasses
    OverloadedRecordDot
    OverloadedStrings
    PolyKinds
    RankNTypes
    RecordWildCards
    ScopedTypeVariables
    TemplateHaskell
    TupleSections
    TypeApplications
    TypeFamilies
    TypeOperators
    TypeSynonymInstances
    UndecidableInstances

  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-uni-patterns
    -Wincomplete-record-updates
    -Wredundant-constraints
    -fhide-source-paths
    -Wpartial-fields
    -Wmissing-deriving-strategies
    -fwrite-ide-info
    -hiedir=.hie
    -Wunused-packages
    -Wall
    -threaded
    -rtsopts
    -with-rtsopts=-N

  build-depends:
    base >=4.11 && <5,
    directory >=1.3.7 && <1.4,
    filepath >=1.4.2 && <1.6,
    hewts >=0.1 && <0.2,
    hibet,
    hspec >=2.11.12,
    text,
    unordered-containers >=0.2.20 && <0.3,

benchmark hibet-benchmark
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: benchmark
  other-modules:
    Common
    Lines

  default-language: Haskell2010
  default-extensions:
    DataKinds
    DeriveGeneric
    DerivingStrategies
    DuplicateRecordFields
    FlexibleContexts
    FlexibleInstances
    GADTs
    LambdaCase
    MultiParamTypeClasses
    OverloadedStrings
    PolyKinds
    RankNTypes
    RecordWildCards
    ScopedTypeVariables
    TemplateHaskell
    TupleSections
    TypeApplications
    TypeFamilies
    TypeOperators
    TypeSynonymInstances
    UndecidableInstances

  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-uni-patterns
    -Wincomplete-record-updates
    -Wredundant-constraints
    -fhide-source-paths
    -Wpartial-fields
    -Wmissing-deriving-strategies
    -fwrite-ide-info
    -hiedir=.hie
    -Wunused-packages
    -threaded
    -rtsopts
    -with-rtsopts=-N

  build-depends:
    base >=4.11 && <5,
    bytestring >=0.11.5.3 && <0.13,
    criterion >=1.6.4.0,
    directory >=1.3.7 && <1.4,
    filepath >=1.4.2 && <1.6,
    text,
    text-rope >=0.3 && <0.4,
